# Copiare in .env e inserire i valori. Nessuna chiave reale nel repo.

# Provider e chiave del modello (usati da src/agent/llm.py)
LLM_PROVIDER=openai
LLM_API_KEY=

# Modello che genera quiz e risponde in chat; modello che giudica le risposte
MODEL_AGENT=
MODEL_JUDGE=

# Embedding locale per il retrieval (sentence-transformers)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Budget di sessione (guardrail 7). Senza entrambi, le chiamate ai modelli sono bloccate.
BUDGET_EUR=10
# Tasso di cambio USD per 1 EUR: da verificare e datare (es. 2026-11-15)
USD_PER_EUR=0,91 EUR

# Opzionale: percorso del database SQLite (default data/app.db)
# DB_PATH=
